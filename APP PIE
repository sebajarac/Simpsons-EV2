import requests
import sys

URL = "https://mindicador.cl/api"

try:
    print("Conectando con la API de Indicadores Económicos...")
    response = requests.get(URL, timeout=5)
    response.raise_for_status()
    
    data = response.json()
    
    uf = data.get('uf').get('valor')
    dolar = data.get('dolar').get('valor')
    euro = data.get('euro').get('valor')
    fecha = data.get('uf').get('fecha')[:10]
    
    print("\n=== DATOS ECONÓMICOS OBTENIDOS ===")
    print(f"Fecha de Consulta: {fecha}")
    print(f"1. Valor UF: ${uf} CLP")
    print(f"2. Valor Dólar: ${dolar} CLP")
    print(f"3. Valor Euro: ${euro} CLP")
    print("===================================")
    print("\n¡Éxito! Datos financieros procesados correctamente en Docker.")

except requests.exceptions.RequestException as e:
    print(f"Error al conectar con la API Financiera: {e}")
    sys.exit(1)
