Tarea Automatización - API Los Simpson
import requests
import sys

URL = "https://thesimpsonsquoteapi.glitch.me/quotes"

try:
    print("Conectando con la API de Los Simpson...")
    response = requests.get(URL, timeout=5)
    response.raise_for_status()

    data = response.json()[0]

    personaje = data.get('character')
    frase = data.get('quote')
    imagen_url = data.get('image')

    print("\n=== DATOS OBTENIDOS DE SPRINGFIELD ===")
    print(f"1. Personaje: {personaje}")
    print(f"2. Frase célebre: "{frase}"")
    print(f"3. URL Imagen: {imagen_url}")
    print("=======================================")
    print("\n¡Éxito! Datos procesados correctamente.")

except requests.exceptions.RequestException as e:
    print(f"Error al conectar con Springfield: {e}")
    sys.exit(1)